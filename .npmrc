# Limit parallel network requests to prevent exceeding cPanel process/connection limits
maxsockets=1

# Limit concurrent compilations/child processes 
jobs=1

# Increase timeouts and retries for slow connections
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Prevent background fetching and sending analytics
fund=false
audit=false
update-notifier=false
